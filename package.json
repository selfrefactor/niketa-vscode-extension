{
  "name": "niketa-vscode-extension",
  "displayName": "Run Niketa scripts",
  "description": "Request to run scripts defined in `package.json`",
  "version": "0.29.0",
  "license": "MIT",
  "publisher": "selfrefactor",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension",
  "contributes": {
    "commands": [
      {
        "command": "niketa.request.lint.file",
        "title": "Lint with current file"
      },
      {
        "command": "niketa.request.run.script",
        "title": "Run script with current file"
      },
      {
        "command": "niketa.cycle.script",
        "title": "Cycle Niketa script"
      },
      {
        "command": "niketa.request.run.test",
        "title": "Run script with current file (legacy)"
      }
    ],
    "keybindings": [
      {
        "command": "niketa.request.lint.file",
        "key": "ctrl+1"
      },
      {
        "command": "niketa.request.run.script",
        "key": "alt+w"
      }
    ]
  },
  "scripts": {
    "postinstall": "node ./node_modules/vscode/bin/install"
  },
  "devDependencies": {
    "vscode": "1.1.37"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/selfrefactor/niketa-vscode-extension.git"
  },
  "dependencies": {
    "minimatch": "10.1.2",
    "rambdax": "11.3.1"
  }
}
